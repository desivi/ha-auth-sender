#!/usr/bin/with-contenv bashio
# Supervisor only injects options as env vars for legacy add-ons, so map them
# explicitly. Each value falls back to the default ha_auth_sender.py uses, so an
# empty bashio::config result cannot abort startup at int(os.environ[...]) .
SYSLOG_HOST="$(bashio::config 'syslog_host')"
SYSLOG_PORT="$(bashio::config 'syslog_port')"
POLL_INTERVAL="$(bashio::config 'poll_interval')"
APP_NAME="$(bashio::config 'app_name')"
LOG_HOST="$(bashio::config 'log_host')"
BOOTSTRAP_MODE="$(bashio::config 'bootstrap')"
ALERTMANAGER_URL="$(bashio::config 'alertmanager_url')"
ALERTMANAGER_TOKEN_FILE="$(bashio::config 'alertmanager_token_file')"
ALERTMANAGER_TOKEN="$(bashio::config 'alertmanager_token')"
INSTANCE="$(bashio::config 'instance')"
SPRAY_THRESHOLD="$(bashio::config 'spray_threshold')"
SPRAY_WINDOW_MINUTES="$(bashio::config 'spray_window_minutes')"
EVENT_RATE_LIMIT_SECONDS="$(bashio::config 'event_rate_limit_seconds')"
SPRAY_RATE_LIMIT_SECONDS="$(bashio::config 'spray_rate_limit_seconds')"
MAX_TRACKED_IPS="$(bashio::config 'max_tracked_ips')"
IP_TTL_HOURS="$(bashio::config 'ip_ttl_hours')"
export SYSLOG_HOST="${SYSLOG_HOST:-192.168.0.20}"
export SYSLOG_PORT="${SYSLOG_PORT:-1514}"
export POLL_INTERVAL="${POLL_INTERVAL:-20}"
export APP_NAME="${APP_NAME:-ha-auth}"
export LOG_HOST="${LOG_HOST:-homeassistant}"
export BOOTSTRAP_MODE="${BOOTSTRAP_MODE:-skip}"
# Empty means the Alertmanager sink stays disabled, which preserves the
# syslog-only behaviour of 1.0.2.
export ALERTMANAGER_URL="${ALERTMANAGER_URL:-}"
export ALERTMANAGER_TOKEN_FILE="${ALERTMANAGER_TOKEN_FILE:-}"
export ALERTMANAGER_TOKEN="${ALERTMANAGER_TOKEN:-}"
export INSTANCE="${INSTANCE:-homeassistant}"
export SPRAY_THRESHOLD="${SPRAY_THRESHOLD:-10}"
export SPRAY_WINDOW_MINUTES="${SPRAY_WINDOW_MINUTES:-10}"
export EVENT_RATE_LIMIT_SECONDS="${EVENT_RATE_LIMIT_SECONDS:-60}"
export SPRAY_RATE_LIMIT_SECONDS="${SPRAY_RATE_LIMIT_SECONDS:-300}"
export MAX_TRACKED_IPS="${MAX_TRACKED_IPS:-2048}"
export IP_TTL_HOURS="${IP_TTL_HOURS:-24}"
exec python3 /opt/ha_auth_sender/ha_auth_sender.py
